# Copy this file to `.env` in the repository root (`.env` is gitignored).
#
# VS Code reads `.env` through the Python extension (`python.envFile`, see
# .vscode/settings.json) for terminals, test runs, debugging and Jupyter
# kernels. Outside VS Code, set the variable in your shell before running
# Python; see "Bytecode" in README.md.

# Do not write __pycache__/ directories or .pyc files.
PYTHONDONTWRITEBYTECODE=1
