{
  "task": "presence",
  "label_source": "ground_truth.has_lesion (source-derived)",
  "input_field": "narrative_clean",
  "train_split": "train",
  "selection_split": "val",
  "models": ["bert", "biobert", "clinicalbert"],
  "seeds": [13, 42, 87],
  "max_length": 512,
  "truncation": "head",
  "epochs": 3,
  "batch_size": 8,
  "gradient_accumulation": 2,
  "eval_batch_size": 32,
  "learning_rate": 2e-05,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "max_grad_norm": 1.0,
  "precision": "bf16",
  "class_weight": "balanced",
  "early_stopping": {"metric": "val_loss", "patience": 1},
  "threshold": 0.5,
  "hyperparameter_search": "none: one fixed setting shared by every model, so no model gets a larger tuning budget"
}
